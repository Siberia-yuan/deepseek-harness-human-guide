        <mxCell id="9" value="four built-in services, visible to every plugin" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Plugin A's ctx (extend child context)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#eff6ff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="11" value="inherits the root&#xa;sees the global services" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="110" y="300" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Plugin B's ctx (extend child context)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#eef2ff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="520" y="240" width="400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="13" value="a private service via isolate&#xa;only B sees it, A does not" style="rounded=1;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="550" y="330" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Every plugin gets its own ctx inheriting the parent. isolate carves out a service scope only the caller can see, e.g. a private implementation for one agent." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
