  <diagram name="事件分发">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="事件的四种分发方式" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1060" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="emit&#xa;围观，看一眼就走&#xa;&#xa;不能改结果&#xa;不等" style="swimlane;startSize=36;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="4" value="waterfall&#xa;接力棒，一个传一个&#xa;&#xa;能改结果&#xa;必须传 next" style="swimlane;startSize=36;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="5" value="parallel&#xa;同时开工&#xa;&#xa;不能改结果&#xa;等全部完成" style="swimlane;startSize=36;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="6" value="serial&#xa;排队来&#xa;&#xa;能改结果&#xa;首个非空即停" style="swimlane;startSize=36;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="90" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="7" value="先看两件事，能不能改结果，要不要等。再看细节，waterfall 最常踩坑。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="900" height="40" as="geometry" />
        </mxCell>
