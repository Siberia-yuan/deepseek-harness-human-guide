<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Event dispatch">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Four ways to dispatch an event" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1060" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="emit&#xa;observe and leave&#xa;&#xa;cannot change the result&#xa;no wait" style="swimlane;startSize=36;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="4" value="waterfall&#xa;a relay, listener to listener&#xa;&#xa;can change the result&#xa;must call next" style="swimlane;startSize=36;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="5" value="parallel&#xa;all start at once&#xa;&#xa;cannot change the result&#xa;waits for all" style="swimlane;startSize=36;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="6" value="serial&#xa;one at a time&#xa;&#xa;can change the result&#xa;stops at the first non-null return" style="swimlane;startSize=36;whiteSpace=wrap;html=1;gradient=1;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="90" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Two questions first, can listeners change the result, does it wait. Then the details, waterfall is where people trip." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1000" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
